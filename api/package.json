{
  "name": "@smartcanteen/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "npm run migrate -w @smartcanteen/db",
    "db:seed": "npm run seed -w @smartcanteen/db",
    "db:seed:sample": "npm run seed:sample -w @smartcanteen/db",
    "db:test:setup": "npm run test:setup -w @smartcanteen/db",
    "user:set-password": "npm run set-password -w @smartcanteen/db"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@node-rs/argon2": "2.2.2",
    "@smartcanteen/db": "0.0.0",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
