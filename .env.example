# Local development only. Copy to .env and replace the placeholder secrets.
NODE_ENV=development
PORT=3000
APP_TIMEZONE=Asia/Manila
TRUST_PROXY=false

DATABASE_URL=postgresql://smartcanteen:local_dev_only_change_me@localhost:5432/smartcanteen
# off | require | verify. Defaults to off outside production and verify in production.
DATABASE_SSL=off
# Required when DATABASE_SSL=verify. Phase 5/6 ships the AWS RDS CA bundle in the image.
DATABASE_SSL_CA_FILE=

POSTGRES_DB=smartcanteen
POSTGRES_USER=smartcanteen
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5432

# Optional; defaults to the DATABASE_URL database name with a _test suffix.
# TEST_DATABASE_URL=
# Local seed-only credentials. Never put real production passwords here.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
