# Local development only. Copy to .env and replace the placeholder secrets.
NODE_ENV=development
PORT=3000
APP_TIMEZONE=Asia/Manila
TRUST_PROXY=false

DATABASE_URL=postgresql://smartcanteen:local_dev_only_change_me@localhost:5432/smartcanteen

POSTGRES_DB=smartcanteen
POSTGRES_USER=smartcanteen
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5432

SESSION_SECRET=replace_with_at_least_32_random_characters
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
